# Template: copy to .env and fill in values. Safe to commit (no secrets here).
# Variables starting with NEXT_PUBLIC_ are sent to the browser, so only put public values there.
# For Vercel, add the same keys under Project → Settings → Environment Variables.

# ── App ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=

# ── Database (Neon Postgres, pooled connection) ─────
DATABASE_URL=

# ── Google sign-in (Better Auth) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Razorpay (USD card payments, subscriptions) ─────
# Razorpay dashboard → Account & Settings → API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── RazorpayX (INR payouts to coaches) ──────────────
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_KEY_ID=
RAZORPAYX_KEY_SECRET=
RAZORPAYX_WEBHOOK_SECRET=

# ── PayPal (secondary payment option) ───────────────
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=

# ── Video (100ms) ───────────────────────────────────
HMS_ACCESS_KEY=
HMS_SECRET=
HMS_TEMPLATE_ID=

# ── Email (Resend) ──────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=

# ── WhatsApp / SMS reminders (Gupshup or Twilio) ────
WHATSAPP_PROVIDER=
GUPSHUP_API_KEY=
GUPSHUP_APP_NAME=
GUPSHUP_SOURCE_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Background jobs (Inngest) ───────────────────────
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# ── Monitoring & analytics ──────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# ── Bot protection on forms (Cloudflare Turnstile) ──
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Cron / internal ─────────────────────────────────
# Any long random string; protects /api/cron/* routes
CRON_SECRET=

# ── Better Auth ─────────────────────────────────────
# Generated locally. Use a different value in production (Vercel env vars).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# ── Cloudflare R2 (coach photos, documents, intro videos) ──
# R2 overview → Account ID; R2 → Manage API tokens (Object Read & Write, this bucket only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for public files (custom domain or r2.dev), no trailing slash
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Coach payout details encryption ──
PAYOUT_ENCRYPTION_KEY=
